plugins =

[nuitka]

macos.permissions =
mode = onefile
extra_args = --quiet --noinclude-qt-translations

[buildozer]

mode = debug
recipe_dir =
jars_dir =
ndk_path = __NDK_PATH__
sdk_path = __SDK_PATH__
local_libs =
arch = aarch64
