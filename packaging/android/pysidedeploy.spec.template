[app]

title = 伴界 BanVerse
project_dir = __PROJECT_DIR__
input_file = __PROJECT_DIR__/main.py
exec_directory = __EXEC_DIR__
project_file =
icon = __PROJECT_DIR__/app_icon.png

[python]

python_path = __PYTHON_PATH__
packages = Nuitka==4.0
android_packages = buildozer==1.5.0,cython==0.29.33

[qt]

qml_files =
excluded_qml_plugins =
modules = Core,Gui,Widgets,Network,Multimedia,TextToSpeech
plugins =

[android]

wheel_pyside = __PYSIDE_WHEEL__
